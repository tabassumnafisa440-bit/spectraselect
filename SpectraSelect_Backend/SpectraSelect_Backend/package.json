{
  "name": "spectraselect-backend",
  "version": "1.0.0",
  "description": "Node.js + Express + MySQL backend for SpectraSelect",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "health": "node -e \"fetch(\"http://localhost:4000/api/health\").then(r=>r.text()).then(console.log).catch(e=>{console.error(e.message);process.exit(1)})\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0"
  }
}
